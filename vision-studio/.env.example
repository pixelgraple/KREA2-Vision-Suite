# Qwen3-VL local defaults. Change the model tag as you install variants.
QWEN_BACKEND=ollama
QWEN_MODEL=qwen3-vl:30b
QWEN_API_BASE=http://127.0.0.1:11434
QWEN_API_KEY=
QWEN_CONTEXT_LENGTH=32768
QWEN_TEMPERATURE_ANALYSIS=0.12
QWEN_TEMPERATURE_CRITIC=0.08
QWEN_TEMPERATURE_MERGER=0.05
QWEN_TEMPERATURE_COMPOSER=0.38
QWEN_MAX_OUTPUT_TOKENS=8192
# Related passes keep the current model resident, then finally unload it while
# the shared GPU lease is still held.
QWEN_KEEP_ALIVE=5m

# Optional verified llama.cpp backend. A model remains hidden until its exact
# 2B F16, 4B Q8_0, or 8B Q8_0 body and matching Q8_0 projector pass the checked-
# in manifest's byte-size and SHA-256 checks.
LLAMA_CPP_SERVER_EXE=~/AppData/Local/Krea2Vision/llama.cpp/b10590/llama-server.exe
LLAMA_CPP_MODEL_ROOT=~/Documents/KreaHereticModels
LLAMA_CPP_ARTIFACT_MANIFEST=scripts/heretic_llamacpp_artifacts.json
# The host is fixed to loopback by the application.
LLAMA_CPP_PORT=8091
LLAMA_CPP_STARTUP_TIMEOUT_SECONDS=180
LLAMA_CPP_VRAM_HEADROOM_MB=4096
LLAMA_CPP_MODEL_ALLOCATION_TARGET_MB=12288
LLAMA_CPP_TELEMETRY_PATH=data/history/llama_cpp_runtime.json
LLAMA_CPP_CONTEXT_CAP=8192

# Optional Vast Serverless Gemma 4 26B-A4B Heretic backend. It remains absent
# from every selector until all fields are configured and enabled. Keep the key
# only in this server-side .env; never put it in BetterDiscord settings.
VAST_SERVERLESS_ENABLED=false
VAST_SERVERLESS_ENDPOINT=
VAST_SERVERLESS_API_KEY=
VAST_SERVERLESS_PYTHON_EXE=~/AppData/Local/Krea2Vision/vastsdk/Scripts/python.exe
VAST_SERVERLESS_REQUEST_TIMEOUT_SECONDS=1200
VAST_SERVERLESS_MODEL_ID=vast::gemma4-26b-a4b-heretic-q3_k_l

STUDIO_HOST=127.0.0.1
STUDIO_PORT=7870
STUDIO_MAX_UPLOAD_MB=30
STUDIO_MAX_IMAGE_PIXELS=60000000
STUDIO_MAX_IMAGE_SIDE=3072
STUDIO_PRIVACY_MODE=true
STUDIO_SAVE_SOURCE_IMAGES=false
STUDIO_SAVE_THUMBNAILS=false

# Exact compatibility with the current Forge SharedGenerationLock protocol.
STUDIO_USE_SHARED_GENERATION_QUEUE=true
KREA2_GPU_AVAILABILITY_TIMEOUT_SECONDS=30
STUDIO_SHARED_QUEUE_DIR=
STUDIO_SHARED_QUEUE_POLL_SECONDS=0.25
STUDIO_SHARED_QUEUE_STALE_SECONDS=21600
STUDIO_FORGE_UNLOAD_URLS=http://127.0.0.1:7861,http://127.0.0.1:7862
STUDIO_FORGE_UNLOAD_TIMEOUT_SECONDS=45
# Existing machine-local credential shared with both Forge APIs. The Studio
# reads this file but never creates or logs it.
STUDIO_FORGE_HANDOFF_TOKEN_FILE=~/AppData/Local/Krea2VisionSuite/forge-handoff-token

# Required for POST /api/discord-describe. Leave this commented/empty until a
# private random token of at least 32 bytes has been generated for deployment.
# KREA2_DISCORD_VISION_TOKEN=

WD14_MODEL=SmilingWolf/wd-vit-tagger-v3
WD14_DEVICE=cpu
